# ==============================================================================
# AgriQuantum Production Environment Variables
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL / Supabase or SQLite)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/agriquantum
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./agriquantum.db

# Authentication & JWT Security
SECRET_KEY=generate_a_secure_64_character_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:8501

# Copernicus Sentinel-2 Satellite Intelligence API Credentials
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SENTINEL_INSTANCE_ID=
COPERNICUS_API_ENDPOINT=https://sh.dataspace.copernicus.eu/api/v1/process

# Open-Meteo High-Resolution Weather API
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Quantum Machine Learning Execution Backend
# Options: statevector (Aer exact fidelity simulation), sampler (Qiskit Sampler primitive)
QUANTUM_BACKEND=statevector
QUANTUM_CIRCUIT_QUBITS=4
QUANTUM_REPS=2

# Error Monitoring & Observability
SENTRY_DSN=
